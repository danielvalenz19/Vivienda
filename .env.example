# Ejemplo documental: el servidor lee variables del entorno; este archivo no se
# carga automáticamente. Nunca guardes credenciales reales en el repositorio.
NODE_ENV=development
PORT=3000
DB_PATH=./vivienda.sqlite
PHOTO_DIR=./uploads
PROFILE_PHOTO_DIR=./profile-photos
EVIDENCE_DIR=./private-evidence
EVIDENCE_RETENTION_DAYS=30
AVAILABILITY_DAYS=14
AVAILABILITY_REMINDER_DAYS=2

# Opcional en desarrollo. Para cifrar nuevas evidencias usá una clave aleatoria
# de 32 bytes codificada en 64 caracteres hexadecimales, obtenida de un gestor
# de secretos. Sin clave, el desarrollo conserva archivos sin cifrar.
# EVIDENCE_ENCRYPTION_KEY=

# No compartir las frases de sesión ni de respaldo. Los respaldos se ejecutan
# con el servidor detenido para que base y archivos correspondan.
# SESSION_SECRET=
# BACKUP_PASSPHRASE=

# Opcional: correo transaccional mediante SMTP con TLS. No se envía correo real
# hasta configurar y comprobar un proveedor. No cargar credenciales en Git.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=

# El modo demo y sus cuentas son solo para pruebas locales. Producción está
# bloqueada en el código mientras falten controles y validación independientes.
DEMO_AUTH=0
